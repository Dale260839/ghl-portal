# BuildSuite™ Platform — environment
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is not,
# so never put a real value in here.
#
# Grouped by what unblocks what. Nothing below is needed to run the fixture demo
# — the app runs today with none of it set.

# ─────────────────────────────────────────────────────────────────────────────
# 1. GHL — unblocks live project data (replaces fixtures)
#    Owner: Sing / Chris · Blocks: everything real
# ─────────────────────────────────────────────────────────────────────────────

# Base URL for the API. Usually https://services.leadconnectorhq.com
GHL_API_BASE_URL=

# API version date header GHL requires on every request (e.g. 2021-07-28).
GHL_API_VERSION=

# DEVELOPMENT DEFAULT ONLY (D-013). The Hub is multi-tenant: one deployment
# serving many sub-accounts, with the location resolved per request from the
# session. This var exists so a developer can work against the build sub-account
# without a GHL login round-trip. It is NOT "the" location — the dev resolver
# refuses any location other than this one rather than falling back to it.
GHL_DEV_LOCATION_ID=

# Private Integration token for the build sub-account (ARCHITECTURE §2 — each
# sub-account uses its own). If we're on OAuth instead, use the three vars
# below and leave this blank.
GHL_PRIVATE_INTEGRATION_TOKEN=

# OAuth alternative — only if a Private Integration token isn't an option.
GHL_OAUTH_CLIENT_ID=
GHL_OAUTH_CLIENT_SECRET=
GHL_OAUTH_REFRESH_TOKEN=

# The Project custom object's key/id as GHL exposes it (e.g. custom_objects.projects).
# Needed to address the object at all; comes out of Phase 0.
GHL_PROJECT_OBJECT_KEY=

# Shared secret GHL signs workflow webhooks with (D4 §3 — the third wire).
#
# POST /api/ghl/webhook REFUSES EVERYTHING without it, in every environment.
# There is deliberately no development bypass: an unverifiable webhook is not a
# webhook, and a dev-only bypass is one environment variable away from being a
# production one.
#
# To exercise the receiver locally, put any string here and sign your test
# payloads with it — the signature is hex HMAC-SHA256 over `timestamp.rawBody`.
# The real secret comes from Pat.
GHL_WEBHOOK_SECRET=

# Shared secret for the Custom Menu Link landing (D-011). Without it, auto-login
# from GHL is REFUSED in production: merge-field query parameters are not
# authentication, and a session minted from them would let a stranger choose
# which contractor's data to receive.
GHL_MENU_LINK_SECRET=

# Development escape hatch — accepts unverified landings so the flow can be
# built before the menu link exists. Ignored in production, and ignored whenever
# GHL_MENU_LINK_SECRET is set, so it cannot silently disable auth.
GHL_ALLOW_UNVERIFIED_LANDING=

# ─────────────────────────────────────────────────────────────────────────────
# 2. Supabase — BuildSuite's database. READ ONLY. Production (D-003, D-009).
#    Owner: Sing / Dale · Blocks: all BuildSuite-side reads
#
#    The Hub reads BuildSuite's data straight from here (D-009) — it does not
#    call BuildSuite's API. There is no BUILDSUITE_API_KEY; that API is
#    cookie-only and out of scope.
#
#    GUARDRAIL: never alter a table. Use a restricted/anon key, NOT service_role,
#    unless a specific named write has been approved by Sing.
# ─────────────────────────────────────────────────────────────────────────────

SUPABASE_URL=
SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 4. App — needed once demo auth is replaced with real sessions
# ─────────────────────────────────────────────────────────────────────────────

# Random 32+ byte string used to sign session cookies. REQUIRED in production —
# the app refuses to start without it rather than generating one, which would
# silently log every user out on each deploy. Development generates one per
# process, so sessions simply don't survive a restart.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Public origin, used for redirects and OAuth callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret the hourly sync-back cron sends so the endpoint can't be
# triggered by anyone who finds the URL.
CRON_SECRET=

# ────────────────────────────────────────────────────────────────────────────
# 5. Feature flags
# ────────────────────────────────────────────────────────────────────────────

# Narrows the projects list to signed work. Set to `true` to switch on.
#
# OFF BY DEFAULT, and that is the point. Nothing in BuildSuite has ever been
# signed — 0 of 182 deals — so turning this on today hides every project that
# has a deal. Measured on the Alliance tenant: 9 projects become 1, and the
# survivor only shows because it has no deal to judge. A contractor opening the
# dashboard to that would read the product as broken.
#
# It is built, tested, and one value away from working. Turn it on when
# signatures start landing, not before.
ENABLE_SIGNED_ONLY_FILTER=

# ────────────────────────────────────────────────────────────────────────────
# 6. The Project Hub's own database
#    Owner: us · Unblocks: every write the Hub makes
# ────────────────────────────────────────────────────────────────────────────

# A SEPARATE Supabase project from BuildSuite's, decided 2026-08-31.
#
# BuildSuite's database is production and stays read-only — SUPABASE_URL above.
# Everything the Hub writes lives here instead: record edits, archives, team
# memberships, invitations and permission grants. Two connections, one rule:
# reads may come from either, writes only ever go here.
#
# Use the PUBLISHABLE key, not a secret one. It is subject to RLS and cannot
# create tables, which is what we want — migrations are run by a human in the
# Supabase SQL editor, never by the application.
HUB_SUPABASE_URL=
HUB_SUPABASE_KEY=

# Signs you in as ANOTHER CONTRACTOR, with their projects, prices and team.
#
# DEVELOPMENT ONLY, and off unless explicitly `true` — the inverse of
# DISABLE_VIEW_AS on purpose. `view-as` shows you your own data through another
# role's lens and is safe to default on; this hands out somebody else's records,
# so a deployment that sets nothing gets no switch.
#
# It exists because verifying that tenancy actually separates two contractors
# requires being both of them, and no amount of reasoning substitutes for
# looking. Delete it when real contractor sign-in ships.
ENABLE_ACCOUNT_SWITCH=
