# BuildSuite™ Platform — environment
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is not,
# so never put a real value in here.
#
# Grouped by what unblocks what. Nothing below is needed to run the fixture demo
# — the app runs today with none of it set.

# ─────────────────────────────────────────────────────────────────────────────
# 1. GHL — unblocks live project data (replaces fixtures)
#    Owner: Sing / Chris · Blocks: everything real
# ─────────────────────────────────────────────────────────────────────────────

# Base URL for the API. Usually https://services.leadconnectorhq.com
GHL_API_BASE_URL=

# API version date header GHL requires on every request (e.g. 2021-07-28).
GHL_API_VERSION=

# DEVELOPMENT DEFAULT ONLY (D-013). The Hub is multi-tenant: one deployment
# serving many sub-accounts, with the location resolved per request from the
# session. This var exists so a developer can work against the build sub-account
# without a GHL login round-trip. It is NOT "the" location — the dev resolver
# refuses any location other than this one rather than falling back to it.
GHL_DEV_LOCATION_ID=

# Private Integration token for the build sub-account (ARCHITECTURE §2 — each
# sub-account uses its own). If we're on OAuth instead, use the three vars
# below and leave this blank.
GHL_PRIVATE_INTEGRATION_TOKEN=

# Tokens for OTHER sub-accounts, as `locationId:token`, comma-separated.
# A Private Integration token only opens its own sub-account (measured 17 Sep:
# 401 "This location is not accessible from this token!" across tenants), so a
# contractor in a different sub-account needs its own entry here. Used by the
# invoice rail and invoice reads only; the token above stays the default for its
# own sub-account, for sign-in, and for email.
GHL_LOCATION_TOKENS=

# OAuth alternative — only if a Private Integration token isn't an option.
GHL_OAUTH_CLIENT_ID=
GHL_OAUTH_CLIENT_SECRET=
GHL_OAUTH_REFRESH_TOKEN=

# The Project custom object's key/id as GHL exposes it (e.g. custom_objects.projects).
# Needed to address the object at all; comes out of Phase 0.
GHL_PROJECT_OBJECT_KEY=

# Native Marketplace webhook verification (D4 §3). Obtain the current published
# Ed25519 key from HighLevel's official Webhook Integration Guide. The route
# uses this key ONLY for X-GHL-Signature; escaped PEM newlines are supported.
# This is a public verification key, not an API token or SSO shared secret.
GHL_WEBHOOK_ED25519_PUBLIC_KEY=

# Legacy RSA-SHA256 public key, ONLY for X-WH-Signature deliveries. A failed or
# blank current signature never falls back to this legacy scheme.
GHL_WEBHOOK_PUBLIC_KEY=

# Optional controlled relay, not native GHL signing. x-signature is hex
# HMAC-SHA256 over `timestamp.rawBody`; x-timestamp is required. Never send a
# relay HMAC on a native signature header. There is no verification bypass.
# Authentication is implemented; workflow execution/durable ingestion are not.
# Recognized workflow events return 503, not a false success acknowledgement.
# Sender retry behavior must be verified in the owning app before enabling it.
GHL_WEBHOOK_SECRET=

# Marketplace Custom Page contractor sign-in, server-only. Both the app Shared
# Secret and expected agency company ID are required. Do not promote this
# release until the replacement GHL iframe entry has passed a real sign-in.
# An API token or unsigned merge-field URL is not contractor authentication.
GHL_APP_SHARED_SECRET=
GHL_SSO_COMPANY_ID=

# Shared secret for the Custom Menu Link landing (D-011). Without it, auto-login
# from GHL is REFUSED in production: merge-field query parameters are not
# authentication, and a session minted from them would let a stranger choose
# which contractor's data to receive.
GHL_MENU_LINK_SECRET=

# Development escape hatch — accepts unverified landings so the flow can be
# built before the menu link exists. Ignored in production, and ignored whenever
# GHL_MENU_LINK_SECRET is set, so it cannot silently disable auth.
GHL_ALLOW_UNVERIFIED_LANDING=

# ─────────────────────────────────────────────────────────────────────────────
# 2. Supabase — BuildSuite's database. READ ONLY. Production (D-003, D-009).
#    Owner: Sing / Dale · Blocks: all BuildSuite-side reads
#
#    The Hub reads BuildSuite's data straight from here (D-009) — it does not
#    call BuildSuite's API. There is no BUILDSUITE_API_KEY; that API is
#    cookie-only and out of scope.
#
#    GUARDRAIL: never alter or write a BuildSuite table. Browser-role SELECT was
#    revoked in September 2026; use a SERVER-ONLY service key for scoped reads.
#    The client has no write method. Never expose this key via NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

SUPABASE_URL=
# Preferred server credential. Existing SUPABASE_ANON_KEY is a legacy fallback,
# not permission to restore browser grants or to write to BuildSuite.
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 4. App — needed once demo auth is replaced with real sessions
# ─────────────────────────────────────────────────────────────────────────────

# Random 32+ byte string used to sign session cookies. REQUIRED in production —
# the app refuses to start without it rather than generating one, which would
# silently log every user out on each deploy. Development generates one per
# process, so sessions simply don't survive a restart.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Public origin, for redirects and OAuth callbacks.
#
# A FALLBACK ONLY since 2026-09-01. Anything generating a link somebody else
# will open — an invitation email, most importantly — asks the request which
# host it arrived on instead (`lib/app-url.ts`). This variable was set to
# localhost in development, nothing overrode it in production, and an invitation
# went out pointing at a machine the recipient does not have.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret the hourly sync-back cron sends so the endpoint can't be
# triggered by anyone who finds the URL.
CRON_SECRET=

# ────────────────────────────────────────────────────────────────────────────
# 5. Feature flags
# ────────────────────────────────────────────────────────────────────────────

# Narrows the projects list to signed work. Set to `true` to switch on.
#
# OFF BY DEFAULT, and that is the point. Nothing in BuildSuite has ever been
# signed — 0 of 182 deals — so turning this on today hides every project that
# has a deal. Measured on the Alliance tenant: 9 projects become 1, and the
# survivor only shows because it has no deal to judge. A contractor opening the
# dashboard to that would read the product as broken.
#
# SUPERSEDED 2026-09-12 — SETTING THIS DOES NOTHING.
#
# The Projects list now filters on stage `awarded` AND a proposal that is
# signed or won (lib/available-projects.ts), which is stricter than this flag
# ever was and is not optional. Kept here only so anyone who set it knows why
# it stopped mattering.
ENABLE_SIGNED_ONLY_FILTER=

# ────────────────────────────────────────────────────────────────────────────
# 6. The Project Hub's own database
#    Owner: us · Unblocks: every write the Hub makes
# ────────────────────────────────────────────────────────────────────────────

# A SEPARATE Supabase project from BuildSuite's, decided 2026-08-31.
#
# BuildSuite's database is production and stays read-only — SUPABASE_URL above.
# Everything the Hub writes lives here instead: record edits, archives, team
# memberships, invitations and permission grants. Two connections, one rule:
# reads may come from either, writes only ever go here.
#
# Use the SERVER-ONLY secret key (sb_secret_... or legacy service_role). Migration
# 0010 revoked anon access, so a publishable key cannot read/write Hub tables.
# Never restore anon grants to make the app work. This key bypasses RLS: scoped
# server authorization is mandatory, and the key must never reach the browser.
# Migrations require specific approval; the application never runs them.
HUB_SUPABASE_URL=
HUB_SUPABASE_KEY=

# Signs you in as ANOTHER CONTRACTOR, with their projects, prices and team.
#
# DEVELOPMENT ONLY, and off unless explicitly `true` — the inverse of
# DISABLE_VIEW_AS on purpose. `view-as` shows you your own data through another
# role's lens and is safe to default on; this hands out somebody else's records,
# so a deployment that sets nothing gets no switch.
#
# It exists because verifying that tenancy actually separates two contractors
# requires being both of them, and no amount of reasoning substitutes for
# looking. Delete it when real contractor sign-in ships.
ENABLE_ACCOUNT_SWITCH=

# Lets the demo identities (Marcus, Priya, Tony, Dana) sign in from `/`.
#
# DEVELOPMENT ONLY, and off unless exactly `true`. The demo identities carry
# REAL BuildSuite profiles and have NO password: with this on, anyone who can
# reach the site can open real client records by typing one of their emails.
# Until 2026-09-15 they were radio buttons on the public sign-in page; this flag
# is what took them off it. Never set it on Vercel or any shared deployment.
# Contractors sign in from the BuildSuite menu in GoHighLevel, not through this.
ENABLE_DEMO_SIGNIN=

# Sends invitation emails through GoHighLevel.
#
# OFF unless explicitly `true`. This is the only thing the Hub does that puts a
# message in a real person's inbox, and a send cannot be recalled. Everything
# else it does to GoHighLevel is a read.
#
# GHL is the channel rather than a new provider because it already holds the
# contact, and a reply lands in the thread the contractor already uses. No new
# credential and no new sending reputation to build.
GHL_SEND_EMAIL=
