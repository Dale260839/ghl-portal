{
  "name": "buildsuite-ghl-portal",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @buildsuite/web",
    "build": "npm run build --workspace @buildsuite/web",
    "test": "npm test --workspace @buildsuite/contracts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "rehearse": "node scripts/rehearse-handoff.mjs",
    "hud": "node scripts/build-hud.mjs",
    "hud:maps": "node scripts/mint-cookies.mjs && node scripts/build-wireframes.mjs && node scripts/build-hud.mjs",
    "check:codes": "node scripts/check-project-codes.mjs",
    "check:ids": "cd apps/web && node --conditions=react-server scripts/check-no-raw-ids.mts",
    "checkin": "node scripts/checkin.mjs"
  }
}
